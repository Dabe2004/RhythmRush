# backend/.npmrc - npm settings for the backend folder only.
#
# better-sqlite3 13 ships ready-made binaries for Windows, macOS and Linux in
# its prebuilds/ folder and never needs a compiler. npm still tries to run
# "node-gyp rebuild" for it (the package contains a binding.gyp file), which
# fails on every computer without Visual Studio Build Tools. Skipping install
# scripts avoids that. "npm start", "npm test" and "npm run ..." still work.
ignore-scripts=true
