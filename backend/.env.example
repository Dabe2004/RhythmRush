# Copy this file to backend/.env and fill in real values.
# backend/.env is gitignored; this example file is committed.
#
# PowerShell:  Copy-Item backend/.env.example backend/.env
#
# A good random key/password (PowerShell):
#   -join ((48..57) + (65..90) + (97..122) | Get-Random -Count 24 | ForEach-Object {[char]$_})

# "development" (default) or "production". For the exhibition use production:
# then the seed script refuses the example API keys below.
NODE_ENV=development

# Port the Express server listens on (API + website).
PORT=3000

# SQLite file path, relative to the /backend folder.
# Use ":memory:" for a throwaway in-memory database (tests).
DB_PATH=./data/rhythm.db

# API key the ESP32 sends in the X-API-Key header (device RR01).
# Never commit the real key; the database stores only its SHA-256 hash.
# The seed script stores the hash only when the device row is NEW: after
# changing this key, delete the database (or the RR01 row) and seed again.
DEVICE_API_KEY=change-me

# API key for the fake uploader in /tools (device SIM01).
# Keep it different from DEVICE_API_KEY so fake games are easy to spot.
# tools/fake_esp32.js reads SIM_API_KEY from the environment or --key; when
# you change it here, pass the same value with --key.
SIM_API_KEY=dev-sim01-key

# Extra browser origins that may call the API, comma separated.
# Leave EMPTY for the defaults: the website served by this server itself plus
# the Vite dev server (http://localhost:5173, http://127.0.0.1:5173) and
# preview (port 4173). Requests without an Origin header (the ESP32, curl)
# are never affected.
# Example: ALLOWED_ORIGINS=http://192.168.1.20:5173
ALLOWED_ORIGINS=

# Most browser tabs that may watch the live game stream (/api/live/stream)
# at the same time; more get 503. Default 100.
LIVE_MAX_CLIENTS=100
