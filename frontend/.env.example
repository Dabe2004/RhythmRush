# Base URL for the API.
#
# Leave it empty for local development: the Vite proxy forwards /api to
# http://localhost:3000, so the browser stays on one origin and there are no
# CORS problems.
#
# Set a full URL only when the API is on another machine, for example:
# VITE_API_URL=http://192.168.1.20:3000
VITE_API_URL=
