# Base URL for the API.
#
# Leave it empty for local development: the Vite proxy forwards /api to
# http://localhost:3000, so the browser stays on one origin and there are no
# CORS problems.
#
# Set a full URL only when the API is on another machine, for example:
# VITE_API_URL=http://192.168.1.20:3000
VITE_API_URL=

# Printed "How to play" brochure (/how-to-play, Print this page). These are
# BUILD-TIME values: change them, then run "npm run build" again.
# Address the printed QR code opens, e.g. http://192.168.1.5:3000 (no
# trailing slash). Empty: the page's own address is used, unless it is
# localhost / 127.0.0.1 / ::1 (then no QR, and "Ask the staff" is printed).
VITE_PUBLIC_URL=
# Booth Wi-Fi name printed under the QR ("Join this Wi-Fi first"). Optional.
VITE_WIFI_NAME=
# WARNING: if set, this password is PRINTED ON PAPER for everyone to see.
# Leave it empty unless the booth Wi-Fi is meant to be open to visitors.
VITE_WIFI_PASSWORD=
