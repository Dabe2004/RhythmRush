# Generated data and databases (never commit these)
ml/data/
backend/data/
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# Dependencies and virtual environments
node_modules/
.venv/
venv/

# Python caches
__pycache__/
*.py[cod]
.pytest_cache/

# Frontend build output and test coverage
frontend/dist/
frontend/node_modules/
dist/
build/
coverage/

# Secrets: real env files are ignored, the example is committed
.env
.env.*
!.env.example

# Design review screenshots (~60 MB of PNGs, local only; see docs/DESIGN.md)
docs/screenshots/

# Firmware secrets (Wi-Fi password, device API key); config.h.example is committed
firmware/**/config.h
*.pem
*.key

# Other secret files that must never reach GitHub
# (certificates, SSH keys, cloud credentials, local tool settings)
*.p12
*.pfx
*.keystore
*.jks
id_rsa*
id_ed25519*
id_ecdsa*
credentials*.json
service-account*.json
*.secret
secrets/
.claude/settings.local.json

# Logs
*.log

# OS and editor junk
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
